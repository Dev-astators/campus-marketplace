    selectedCategory: "All Categories",
    setSelectedCategory: jest.fn(),
    selectedCondition: "all",
    setSelectedCondition: jest.fn(),
    minPrice: "",
    setMinPrice: jest.fn(),
    maxPrice: "",
    setMaxPrice: jest.fn(),
    sortBy: "newest",
    setSortBy: jest.fn(),
    clearFilters: jest.fn(),
    filteredListings: [],
