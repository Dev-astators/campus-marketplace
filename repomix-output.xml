&nbsp;
const getTodayInJohannesburg = () =&gt;
  new Intl.DateTimeFormat("en-CA", {
    timeZone: FACILITY_TIME_ZONE,
  }).format(new Date());
&nbsp;
const formatSlotTime = (slotTime) =&gt;
  typeof slotTime === "string" ? slotTime.slice(0, 5) : <span class="branch-1 cbranch-no" title="branch not covered" >"";</span>
&nbsp;
const formatActivityTime = (value) =&gt; {
  <span class="missing-if-branch" title="if path not taken" >I</span>if (!value) {
<span class="cstat-no" title="statement not covered" >    return "";</span>
  }
&nbsp;
  return new Intl.DateTimeFormat("en-ZA", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
    timeZone: FACILITY_TIME_ZONE,
  }).format(new Date(value));
};
&nbsp;
const normalizeOperatingHours = (operatingHours) =&gt; {
  <span class="missing-if-branch" title="if path not taken" >I</span>if (Array.isArray(operatingHours)) {
<span class="cstat-no" title="statement not covered" >    return operatingHours.map(<span class="fstat-no" title="function not covered" >(e</span>ntry) =&gt; (<span class="cstat-no" title="statement not covered" >{</span></span>
