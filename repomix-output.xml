    fullSlots: dashboardData.metrics.fullSlots,
    transactionQueue: dashboardData.transactions,
    activityLog: dashboardData.activityLog,
    selectedDate: dashboardData.selectedDate,
    advanceTransaction,
    loading,
    error,
    actionLoadingId,
  };
}
