                  </label>
                </p>

                {image ? (
                  <article className="mt-5 grid gap-4 rounded-2xl border border-gray-200 bg-white p-4 md:grid-cols-[160px_1fr]">
                    {imagePreviewUrl ? (
                      <figure className="overflow-hidden rounded-xl border border-gray-200 bg-gray-100">
                        <img
