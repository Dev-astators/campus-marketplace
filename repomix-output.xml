    expect(screen.getByTestId("titles")).toHaveTextContent(
      "Laptop|Algebra Textbook|Desk Lamp",
    );

    await user.click(screen.getByRole("button", { name: /sort title/i }));
    expect(screen.getByTestId("titles")).toHaveTextContent(
      "Algebra Textbook|Desk Lamp|Laptop",
    );
  });
});
</file>

