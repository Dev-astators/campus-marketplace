import ActivityFeed from "../components/staff-dashboard/ActivityFeed";
import useStaffDashboard from "../hooks/useStaffDashboard";
&nbsp;
export default function StaffDashboard() {
  const {
    activeNav,
    setActiveNav,
    viewContent,
    heroStats,
    staffProfile,
    facilityProfile,
    facilityHours,
    todaysBookings,
    totalCapacity,
    totalBookedSlots,
    pendingTransactions,
